{
  "name": "studiobridge-monorepo",
  "version": "2.0.0",
  "description": "Bi-directional script synchronization tool between Roblox Studio and local file systems",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kaji11-jp/StudioBridge.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run build && node packages/core/test/integration.test.ts",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "start": "node packages/cli/dist/index.js start"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@yao-pkg/pkg": "^6.25.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.2"
  }
}
